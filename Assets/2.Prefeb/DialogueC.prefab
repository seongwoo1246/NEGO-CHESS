    requireMan: 0
    NegoPowerOver: 0
    icon: {fileID: -9054060596661462530, guid: a1fc63e4d2adff04cbada3c2bb577acf, type: 3}
  - characterType: 1
    dialogueText: "\uBBFC\uC871\uC758 \uC0C1\uCC98\uAC00 \uC0DD\uAE34 \uB0A0\uC785\uB2C8\uB2E4.\n\uADF8
      \uB2F9\uC2DC\uC5D0 \uCD1D\uC131\uACFC \uB300\uD3EC \uC18C\uB9AC \n\uD53C\uB09C
      \uAC14\uB358 \uAE30\uC5B5\uC774 \uB610\uB837\uD569\uB2C8\uB2E4.\n\uADF8 \uB54C
      \uC7A1\uACE0 \uC788\uB358 \uBD80\uBAA8\uB2D8\uC758 \uC190\uC758 \uB5A8\uB9BC\n\uC628\uAE30\uB294
      \uC544\uC9C1\uAE4C\uC9C0\uB3C4 \uAE30\uC5B5\uB0A9\uB2C8\uB2E4."
    isBirthdayCondition: 0
    targetMonth: 6
