    icon: {fileID: -9054060596661462530, guid: a1fc63e4d2adff04cbada3c2bb577acf, type: 3}
  - characterType: 1
    dialogueText: "\uC81C\uD5CC\uC808\uC774\uAD70\uC694\n\uD5CC\uBC95\uC774 \uC81C\uC815
      \uB41C \uB0A0\uC785\uB2C8\uB2E4.\n5\uB300 \uAD6D\uACBD\uC77C \uC911 \uD558\uB098\uC785\uB2C8\uB2E4\uB9CC
      \n\uC608\uC804\uC5D0\uB294 \uD734\uC77C\uC774\uC600\uB294\uB370 \uC9C0\uAE08\uC740
      \uC544\uB2CC \uAC78\uB85C \uC54C \uACE0 \uC788\uC2B5\uB2C8\uB2E4\uB9CC \uC624\uB298
      \uD558\uB8E8\uB3C4 \uBB34\uC0AC\uD788 \uBCF4\uB0B4\uC168\uC2B5\uB2C8\uAE4C?"
