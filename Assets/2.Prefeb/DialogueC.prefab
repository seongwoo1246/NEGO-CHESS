  dailyDialogues_Seo:
  - characterType: 0
    dialogueText: "\uC548\uB155\uD558\uC138\uC694. {0}\n\uC624\uB298 \uD558\uB8E8\uB294
      \uC5B4\uB5A4 \uD558\uB8E8\uC600\uB098\uC694?\n\uB9CC\uC871\uC2A4\uB7EC\uC6B4
      \uD558\uB8E8\uC600\uB2E4\uBA74 \uB2E4\uD589\uC785\uB2C8\uB2E4.\n\uC544\uB2C8\uB77C\uBA74
      \uC800\uC640 \uCCB4\uC2A4 \uD55C \uD310 \uD558\uBA70 \uC774\uC57C\uAE30 \uD560\uAE4C\uC694?\n\uBD88\uB9CC\uC744
      \uB4E4\uC5B4\uC8FC\uB294 \uC815\uB3C4\uB77C\uBA74 \uAE30\uAEBC\uC774 \uD574\uB4DC\uB9AC\uC8E0."
