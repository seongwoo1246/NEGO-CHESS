  - characterType: 1
    dialogueText: "\uD604\uCDA9\uC77C \n\uC800\uB294 \uC624\uB298 \uC544\uCE68\uC5D0
      \uC804\uC6B0\uB4E4\uC5D0\uAC8C \uAC14\uB2E4\uC654\uC5C8\uC2B5\uB2C8\uB2E4.
      \uC774 \uB0A0\uC740 \uC870\uAE08 \uAC10\uC131\uC801\uC73C\uB85C \uBCC0\uD558\uB294
      \uAC78\uC9C0\uB3C4 \uBAA8\uB974\uACA0\uC2B5\uB2C8\uB2E4."
    isBirthdayCondition: 0
    targetMonth: 6
