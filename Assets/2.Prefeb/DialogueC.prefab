  - characterType: 1
    dialogueText: "5.18\n\uC774 \uB54C\uB294 \uC81C\uAC00 \uC800\uD0DD\uC5D0\uC11C
      \uC77C\uD558\uAC8C \uB41C\uC9C0 \uC2DC\uAC04\uC774 \uB9CE\uC774 \uC9C0\uB0AC\uC744
      \uB54C\uC600\uC9C0\uC694. \uB2F9\uC2DC\uC5D0\uB294 \uBAB0\uB790\uC9C0\uB9CC
      \uB098\uC911\uC5D0 \uB274\uC2A4\uB97C \uBCF4\uB2C8 \uD070\uC77C\uC774\uC600\uB2E4\uACE0
      \uB4E4\uC5C8\uC2B5\uB2C8\uB2E4. \uBBFC\uC8FC\uC8FC\uC758\uC758 \uC5ED\uC0AC\uC758
      \uD55C \uD398\uC774\uC9C0\uB97C \uC368\uB0B4\uB824\uAC14\uC5C8\uB358 \uC2DC\uC808\uC774\uC600\uC2B5\uB2C8\uB2E4.  "
    isBirthdayCondition: 0
    targetMonth: 5
    targetDay: 18
    requireGirl: 0
    requireMan: 0
    NegoPowerOver: 0
