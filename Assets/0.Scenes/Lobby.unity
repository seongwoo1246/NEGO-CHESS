  m_Script: {fileID: 11500000, guid: 2b823f7f79a3fe542bbc611c333a7e91, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DialogueController
  characterText: {fileID: 612238781}
  CharIcon: {fileID: 743753900}
  dailyDialogues_Seo:
  - characterType: 0
    dialogueText: "\uC548\uB155\uD558\uC138\uC694. {0}\n\uC624\uB298 \uD558\uB8E8\uB294
      \uC5B4\uB5A4 \uD558\uB8E8\uC600\uB098\uC694?\n\uB9CC\uC871\uC2A4\uB7EC\uC6B4
      \uD558\uB8E8\uC600\uB2E4\uBA74 \uB2E4\uD589\uC785\uB2C8\uB2E4.\n\uC544\uB2C8\uB77C\uBA74
      \uC800\uC640 \uCCB4\uC2A4 \uD55C \uD310 \uD558\uBA70 \uC774\uC57C\uAE30 \uD560\uAE4C\uC694?\n\uBD88\uB9CC\uC744
      \uB4E4\uC5B4\uC8FC\uB294 \uC815\uB3C4\uB77C\uBA74 \uAE30\uAEBC\uC774 \uD574\uB4DC\uB9AC\uC8E0."
    isBirthdayCondition: 0
    targetMonth: 0
    targetDay: 0
    requireGirl: 0
    requireMan: 0
    NegoPowerOver: 0
    icon: {fileID: -2609879190663527008, guid: 5b81198af7bfa1245aec5842eefaf7e5, type: 3}
  - characterType: 0
    dialogueText: "\uC548\uB155\uD558\uC138\uC694. {0}\n\uD559\uAD50\uB294 \uC5B4\uB560\uB098\uC694?
      \uC544\uB2C8\uBA74 \uC9C1\uC7A5\uC77C\uAE4C\uC694?\n\uADF8\uB7F0\uAC8C \uBB50\uAC00
      \uC911\uC694 \uD560\uAE4C\uC694. \n\uADF8\uC800 \uC624\uB298\uB3C4 \uC774\uB807\uAC8C
      \uB9C8\uC8FC \uC549\uC544 \uCCB4\uC2A4\uB97C \uB458 \uC218 \uC788\uB294\n\uC624\uB298\uC5D0
      \uAC10\uC0AC\uD560 \uBFD0\uC785\uB2C8\uB2E4.\n\uADF8\uB7FC \uC624\uB298\uC740
      \uBB34\uC2A8 \uC774\uC57C\uAE30\uB97C \uD574\uBCFC\uAE4C\uC694?"
    isBirthdayCondition: 0
    targetMonth: 0
    targetDay: 0
    requireGirl: 0
    requireMan: 0
    NegoPowerOver: 0
    icon: {fileID: -2609879190663527008, guid: 5b81198af7bfa1245aec5842eefaf7e5, type: 3}
  - characterType: 0
    dialogueText: "\uC548\uB155\uD558\uC138\uC694. {0}\n\uD45C\uC815\uC774 \uC65C
      \uADF8\uB7EC\uC2E0\uAC00\uC694? \uC624\uB298\uC740 \uC880 \uC5B4\uB461\uB124\uC694.\n\uADF8\uB807\uB124\uC694.
      \uC774\uB7F4 \uB54C\uB294 \uAC00\uBCCD\uAC8C \uB530\uB4EF\uD55C \uBB3C\uC774\uB77C\uB3C4
      \uB9C8\uC2DC\uBA70\n\uC774\uC57C\uAE30\uB97C \uB4E4\uC5B4 \uBCFC\uAE4C\uC694?
      \uAC71\uC815\uD558\uC9C0\uB9C8\uC138\uC694.\n\uC800. \uC785\uC740 \uBB34\uAC70\uC6B4
      \uD3B8\uC785\uB2C8\uB2E4. \uC54C\uC8E0^^"
    isBirthdayCondition: 0
    targetMonth: 0
    targetDay: 0
    requireGirl: 0
    requireMan: 0
    NegoPowerOver: 0
    icon: {fileID: -7475954394319961426, guid: 8d7cefe3070fb844eb7cb803b924a425, type: 3}
  - characterType: 0
    dialogueText: "\uC548\uB155\uD558\uC138\uC694. {0}\n\uC624\uB298\uC740 \uD45C\uC815\uC774
      \uC88B\uC544\uBCF4\uC774\uB124\uC694. \uC88B\uC740 \uC77C\uC774\uB77C\uB3C4
      \uC788\uC5C8\uB098\uC694?\n\uC7A0\uAE50\uB9CC\uC694 \uC81C\uAC00 \uD55C\uBC88
      \uB9DE\uCDB0\uBCFC\uAC8C\uC694.\n\uD639\uC2DC \uC88B\uC740 \uC0AC\uB78C\uC774\uB77C\uB3C4
